---
// Muted, looped, inline product video that only plays while in view and never under reduced motion.
// Media files are NOT in git (GitHub Release media-v1 → public/media/ in CI). Existence is checked at BUILD time:
//   mp4 + poster → <video poster>; poster only → <img>; nothing → render nothing (no broken UI, no layout shift).
import { mediaFile, mediaState } from '../lib/media';

interface Props { name: string; label: string; class?: string }
const { name, label, class: cls } = Astro.props;
const state = mediaState(name);
const hasVideo = state === 'video';
const hasPoster = mediaFile(`${name}.poster.jpg`);
const src = `/media/${name}.mp4`;
const poster = `/media/${name}.poster.jpg`;
---
{(hasVideo || hasPoster) && (
  <figure class:list={['media', cls]} data-reveal>
    {hasVideo ? (
      <>
      <video
        data-inview-video
        preload="none"
        muted
        loop
        playsinline
        disablepictureinpicture
        data-poster={hasPoster ? poster : undefined}
        width="1920"
        height="1080"
        aria-label={label}
      >
        <source src={src} type="video/mp4" />
      </video>
      {hasPoster && <noscript><img src={poster} alt={label} width="1920" height="1080" loading="lazy" decoding="async" class="noscript-poster" /></noscript>}
      </>
    ) : (
      <img src={poster} alt={label} width="1920" height="1080" loading="lazy" decoding="async" />
    )}
  </figure>
)}
<style>
  .media {
    margin: 0; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-lg);
    border: 1px solid var(--color-bg-line); background: var(--color-bg-surface);
  }
  .media video, .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .media { position: relative; }
  .media .noscript-poster { position: absolute; inset: 0; }
</style>
<script>
  // <video poster> has no native lazy loading, so posters are attached from data-poster when the video
  // nears the viewport (keeps ~500 KB of below-fold JPGs off the critical path). Without JS or
  // IntersectionObserver the poster is attached at once. Playback: only when >=35% visible, never under
  // reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-inview-video]');
  const attachPoster = (v: HTMLVideoElement) => {
    const p = v.dataset.poster;
    if (p && !v.poster) v.poster = p;
  };
  if (!('IntersectionObserver' in window)) {
    vids.forEach(attachPoster);
  } else if (vids.length) {
    const near = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          attachPoster(e.target as HTMLVideoElement);
          near.unobserve(e.target);
        }
      },
      { rootMargin: '600px 0px' },
    );
    vids.forEach((v) => near.observe(v));
    if (!reduce) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              attachPoster(v);
              v.play().catch(() => { /* missing file or autoplay refused: the poster stays */ });
            } else v.pause();
          }
        },
        { threshold: 0.35 },
      );
      vids.forEach((v) => io.observe(v));
    }
  }
</script>

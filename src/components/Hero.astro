---
/**
 * Home hero: the poster is the LCP element (art-directed <picture>, AVIF/WebP, fetchpriority=high) with the
 * headline + CTA as real HTML over it. After first paint + idle, the WebGL island mounts src/hero on the same
 * slot, gated by shouldRunWebGL() inside mountHero(); its canvas fades in over the poster on its first rendered
 * frame. The camera emulates object-fit: cover about the same principal point, so the swap does not jump.
 */
import { POSTERS, MOBILE_MEDIA, objectPosition, posterSrc } from '../hero/poster';
import { CTA } from '../lib/site.mjs';

const [dx, dy] = objectPosition('desktop');
const [mx, my] = objectPosition('mobile');
const d = POSTERS.desktop;
const m = POSTERS.mobile;
---
<section class="hero" data-hero-root style={`--pos-d:${dx}% ${dy}%;--pos-m:${mx}% ${my}%`}>
  <div id="hero-slot" class="hero-slot" aria-hidden="true">
    <picture class="hero-poster" data-hero-poster>
      <source media={MOBILE_MEDIA} type="image/avif" srcset={posterSrc('mobile', 'avif')} width={m.width} height={m.height} />
      <source media={MOBILE_MEDIA} type="image/webp" srcset={posterSrc('mobile', 'webp')} width={m.width} height={m.height} />
      <source type="image/avif" srcset={posterSrc('desktop', 'avif')} width={d.width} height={d.height} />
      <img src={posterSrc('desktop', 'webp')} alt="" width={d.width} height={d.height} fetchpriority="high" decoding="async" />
    </picture>
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="container hero-copy">
    <p class="eyebrow">ROS2 MCP · WiseOS</p>
    <h1 class="display">The AI layer for ROS&nbsp;2 robots.</h1>
    <p class="lede">Agents that see, understand and operate your fleet.</p>
    <div class="actions">
      <a class="btn btn-primary" href={CTA.href}>{CTA.label}</a>
      <a class="btn btn-ghost" href="/docs/">Read the docs</a>
    </div>
  </div>
</section>

<script>
  import type Lenis from 'lenis';

  const slot = document.getElementById('hero-slot');
  const root = slot?.closest<HTMLElement>('[data-hero-root]');

  function start() {
    if (!slot || !root) return;
    import('../hero/index').then(({ mountHero }) => {
      // beats play while the hero scrolls away: 0 at rest, 1 once the hero's bottom reaches the header
      const progress = () => {
        const lenis = (window as Window & { __lenis?: Lenis }).__lenis;
        const y = lenis ? lenis.scroll : window.scrollY;
        return Math.min(1, Math.max(0, y / Math.max(1, root.offsetHeight)));
      };
      const handle = mountHero(slot, { scrollProgress: progress, label: 'base_link' });
      (window as Window & { __lenis?: Lenis }).__lenis?.on('scroll', () => handle.invalidate());
    });
  }

  // after first paint and once the main thread is idle: the poster owns LCP, WebGL is enhancement only
  const idle = (cb: () => void) =>
    'requestIdleCallback' in window ? window.requestIdleCallback(cb, { timeout: 3000 }) : window.setTimeout(cb, 1500);
  if (document.readyState === 'complete') idle(start);
  else window.addEventListener('load', () => idle(start), { once: true });
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--layout-header));
    display: grid;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(120% 90% at 30% 42%, var(--color-bg-raised) 0%, var(--color-bg-base) 70%);
  }
  .hero-slot { position: absolute; inset: 0; z-index: 0; }
  .hero-poster, .hero-poster img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-poster img { object-fit: cover; object-position: var(--pos-d); }
  .hero-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgb(7 8 11 / 0.55) 0%, rgb(7 8 11 / 0.25) 34%, rgb(7 8 11 / 0) 52%);
  }
  .hero-copy { position: relative; z-index: 2; padding-block: var(--space-16); }
  .hero-copy > * { max-width: min(41vw, 640px); }
  .display { font-size: clamp(3rem, 1rem + 4.45vw, 5rem); line-height: 0.98; letter-spacing: -0.035em; margin-bottom: var(--space-6); }
  .lede { max-width: 30ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  /* same query as MOBILE_MEDIA in src/hero/poster.ts (CSS can't import it) */
  @media (max-width: 767px), (max-aspect-ratio: 4/5) {
    .hero { align-items: start; }
    .hero-poster img { object-position: var(--pos-m); }
    .hero-copy { padding-block: var(--space-12) 0; }
    .hero-copy > * { max-width: none; }
    .display { font-size: 2.5rem; margin-bottom: var(--space-4); }
    .lede { font-size: var(--size-base); }
    .actions { margin-top: var(--space-6); }
    .actions .btn-ghost { display: none; }
    .hero-scrim { background: linear-gradient(180deg, rgb(7 8 11 / 0.6) 0%, rgb(7 8 11 / 0.3) 38%, rgb(7 8 11 / 0) 55%); }
  }
</style>

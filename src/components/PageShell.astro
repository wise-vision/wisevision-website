---
// Plain page shell (404). First viewport = no data-reveal (launch audit F1).
interface Props { eyebrow?: string; title: string; lede?: string }
const { eyebrow, title, lede } = Astro.props;
---
<section class="section container shell">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <div><slot /></div>
</section>
<style>
  .shell { padding-top: var(--space-32); }
</style>

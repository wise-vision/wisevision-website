---
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';
import { SITE } from '../lib/site.mjs';
---
<Base title="ROS2 MCP" description="ROS2 MCP: an open-source (MPL-2.0) Model Context Protocol server for ROS 2 Humble and Jazzy.">
  <PageShell eyebrow="Open source · MPL-2.0" title="ROS2 MCP" lede="A Model Context Protocol server that connects AI agents to ROS 2 Humble and Jazzy systems. Full page coming soon.">
    <div id="install">
      <h2>Install</h2>
      <p class="muted">Installation steps live in the repository README until the docs are complete.</p>
      <p><a class="btn btn-primary" href={SITE.repo} rel="noopener">View on GitHub</a></p>
    </div>
  </PageShell>
</Base>

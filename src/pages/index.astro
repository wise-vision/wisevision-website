---
// Home: hero → 3 beats → ROS2 MCP → WiseOS → Defence → docs CTA. All text comes from content/copy/home.md.
import CopyPage from '../layouts/CopyPage.astro';
import Blocks from '../components/copy/Blocks.astro';
import Actions from '../components/copy/Actions.astro';
import VideoSlot from '../components/VideoSlot.astro';
import Hero from '../components/Hero.astro';
import { loadCopy, section, headingOf, bodyOf, groupsOf, resolveHref } from '../lib/pages';
import { inline } from '../lib/copy';
import { mediaState } from '../lib/media';

const doc = loadCopy('home');
const hero = section(doc, 'hero');
const chip = section(doc, 'hero-chip', true);
const beats = groupsOf(section(doc, 'beats'));
const mcp = section(doc, 'ros2-mcp');
const wiseos = section(doc, 'wiseos');
const defence = section(doc, 'defence');
const docsCta = section(doc, 'docs-cta');
const [lede, proof] = hero.blocks.filter((b) => b.type === 'paragraph');
const chipQ = chip.blocks.find((b) => b.type === 'quote');
const chipLink = chip.blocks.find((b) => b.type === 'paragraph');
const html = (s: string) => inline(s, { resolve: resolveHref });
// Fallback asides when a product video is not available: copy-backed content only (no invented claims).
const rosLoad = loadCopy('ros2-mcp');
const installCmd = rosLoad.sections.install?.blocks.find((b) => b.type === 'code' && b.lang === 'bash');
const wiseCaps = groupsOf(section(loadCopy('wiseos'), 'capabilities')).map((g) => g.title);
const products = [
  { s: mcp, id: 'ros2-mcp', video: 'ros2-mcp-30s-16x9', label: 'ROS2 MCP: an AI agent reading a live ROS 2 graph' },
  { s: wiseos, id: 'wiseos', video: 'wiseos-30s-16x9', label: 'WiseOS: one screen for the whole fleet' },
  { s: defence, id: 'defence', video: 'defence-30s-16x9', label: 'Defence and dual-use robotics' },
];
---
<CopyPage slug="home">
  <Hero>
    {hero.fields.eyebrow && <p class="eyebrow" data-reveal>{hero.fields.eyebrow}</p>}
    <h1 id="hero-title" class="display" data-reveal style="--reveal-i:1" set:html={html(headingOf(hero, 1)).replace(/ROS 2/g, 'ROS&nbsp;2')} />
    {lede && lede.type === 'paragraph' && <p class="hero-lede" data-reveal style="--reveal-i:2" set:html={html(lede.text)} />}
    <Actions links={hero.links} />
    <Fragment slot="foot">
      {proof && proof.type === 'paragraph' && <p class="proof-line" data-reveal style="--reveal-i:4" set:html={html(proof.text)} />}
      {chipQ && chipQ.type === 'quote' && (
        <a class="chip" href={resolveHref('/docs/')} data-reveal style="--reveal-i:4">
          <span class="chip-q">“{chipQ.text}”</span>
          {chipLink && chipLink.type === 'paragraph' && <span class="chip-a">{chipLink.text.replace(/\s*→.*$/, '')} <span aria-hidden="true">→</span></span>}
        </a>
      )}
    </Fragment>
  </Hero>

  <section class="section container beats" aria-label="What your agent can do">
    <ol>
      {beats.map((b, i) => (
        <li data-reveal style={`--reveal-i:${i}`}>
          <span class="num" aria-hidden="true">0{i + 1}</span>
          <h2 class="beat-title">{b.title}</h2>
          <Blocks blocks={b.blocks} reveal={false} />
        </li>
      ))}
    </ol>
  </section>

  {products.map(({ s, id, video, label }, i) => (
    <section class:list={['section', 'product', i % 2 ? 'flip' : '']} aria-labelledby={`p-${id}`}>
      <div class="container product-grid">
        <div class="product-copy">
          {s.fields.eyebrow && <p class="eyebrow" data-reveal>{s.fields.eyebrow}</p>}
          <h2 id={`p-${id}`} class="product-title" data-reveal style="--reveal-i:1" set:html={html(headingOf(s, 3))} />
          <Blocks blocks={bodyOf(s, 3)} />
          <Actions links={s.links} />
        </div>
        <div class="product-media">
          {mediaState(video) !== 'none' ? (
            <VideoSlot name={video} label={label} />
          ) : id === 'ros2-mcp' && installCmd && installCmd.type === 'code' ? (
            <div class="aside term" data-reveal style="--reveal-i:2">
              <div class="term-bar" aria-hidden="true"><span></span><span></span><span></span><em>terminal</em></div>
              <pre tabindex="0"><code><span class="prompt" aria-hidden="true">$ </span>{installCmd.code}</code></pre>
              <p class="term-note">stdio · no port to expose · Humble + Jazzy</p>
            </div>
          ) : id === 'wiseos' ? (
            <ol class="aside caps" data-reveal style="--reveal-i:2" aria-label="WiseOS building blocks">
              {wiseCaps.map((c, n) => <li><span aria-hidden="true">0{n + 1}</span>{c}</li>)}
            </ol>
          ) : (
            <div class="aside stat" data-reveal style="--reveal-i:2">
              <p class="stat-num">25,000+</p>
              <p class="stat-label">ground-robot logistics and evacuation missions in one month, August 2026 <cite>Ministry of Defence of Ukraine</cite><span data-claim="def-ugv-missions" hidden></span></p>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="section container" aria-labelledby="docs-cta">
    <div class="docs-card" data-reveal>
      <h2 id="docs-cta" set:html={html(headingOf(docsCta, 3))} />
      <Blocks blocks={bodyOf(docsCta, 3)} reveal={false} />
      <Actions links={docsCta.links} reveal={false} />
    </div>
  </section>
</CopyPage>
<style>
  /* hero type: the poster's copy zone (src/hero/poster.ts copyZone) was measured at this scale; re-run
     hero-lab/scripts/copy-zone.mjs + the composition gate if it changes */
  .display { font-size: clamp(3rem, 1rem + 4.45vw, 5rem); line-height: 0.98; letter-spacing: -0.035em; margin-bottom: var(--space-6); }
  .hero-lede { max-width: 30ch; font-size: var(--size-lg); color: var(--color-text-muted); }
  .proof-line { margin-top: 0; font-family: var(--font-mono); font-size: var(--size-xs); letter-spacing: 0.04em; color: var(--color-text-muted); }
  .chip {
    display: inline-flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); align-items: center; margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4); border-radius: var(--radius-pill); text-decoration: none;
    border: 1px solid var(--color-bg-line); background: color-mix(in srgb, var(--color-bg-surface) 80%, transparent);
  }
  .chip-q { color: var(--color-text); font-family: var(--font-mono); font-size: var(--size-sm); }
  .chip-a { color: var(--color-accent-text); font-size: var(--size-sm); }
  .chip:hover { border-color: var(--color-accent); }

  .beats ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  .beats li { border-top: 1px solid var(--color-bg-line); padding-top: var(--space-6); }
  .num { display: block; font-family: var(--font-mono); font-size: var(--size-xs); color: var(--color-accent-text); letter-spacing: var(--tracking-caps); margin-bottom: var(--space-4); }
  .beat-title { font-size: var(--size-2xl); }

  .product { border-top: 1px solid var(--color-bg-line); }
  .product-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(var(--space-8), 5vw, var(--space-16)); align-items: center; }
  .flip .product-grid { grid-template-columns: 6fr 5fr; }
  .flip .product-copy { order: 2; }
  .product-title { font-size: var(--size-3xl); line-height: var(--leading-tight); max-width: 16ch; }
  .aside { margin: 0; border: 1px solid var(--color-bg-line); border-radius: var(--radius-lg); background: var(--color-bg-raised); }
  .term { overflow: hidden; box-shadow: 0 40px 120px -40px color-mix(in srgb, var(--color-accent) 25%, transparent); }
  .term-bar { display: flex; gap: 8px; align-items: center; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-bg-line); }
  .term-bar span { width: 10px; height: 10px; border-radius: 50%; background: var(--color-bg-line); }
  .term-bar em { margin-left: auto; font-style: normal; font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-subtle); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .term pre { margin: 0; padding: var(--space-8) var(--space-6); overflow-x: auto; font-size: clamp(0.95rem, 0.8rem + 0.6vw, 1.35rem); }
  .term code { color: var(--color-text); }
  .prompt { color: var(--color-accent); }
  .term-note { margin: 0; padding: 0 var(--space-6) var(--space-6); font-family: var(--font-mono); font-size: var(--size-xs); color: var(--color-text-subtle); }
  .caps { list-style: none; padding: var(--space-4) var(--space-8); }
  .caps li { display: flex; align-items: baseline; gap: var(--space-6); padding-block: var(--space-4); border-bottom: 1px solid var(--color-bg-line); font-family: var(--font-display); font-weight: var(--weight-display); font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem); letter-spacing: var(--tracking-display); }
  .caps li:last-child { border-bottom: 0; }
  .caps span { font-family: var(--font-mono); font-size: var(--size-xs); font-weight: 400; color: var(--color-accent-text); letter-spacing: var(--tracking-caps); }
  .stat { padding: clamp(var(--space-8), 5vw, var(--space-16)); background: radial-gradient(ellipse at 0% 100%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 60%), var(--color-bg-raised); }
  .stat-num { margin: 0; font-family: var(--font-display); font-weight: var(--weight-display); font-size: clamp(4rem, 2rem + 7vw, 8.5rem); line-height: 1; letter-spacing: var(--tracking-display); color: var(--color-accent); }
  .stat-label { margin: var(--space-4) 0 0; color: var(--color-text-muted); max-width: 36ch; }
  .stat-label cite { display: block; margin-top: var(--space-2); font-style: normal; font-family: var(--font-mono); font-size: var(--size-xs); color: var(--color-text-subtle); }

  .docs-card {
    border: 1px solid var(--color-bg-line); border-radius: var(--radius-lg); padding: clamp(var(--space-8), 6vw, var(--space-24));
    background: radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 60%), var(--color-bg-raised);
  }
  .docs-card h2 { font-size: var(--size-3xl); max-width: 18ch; }

  @media (max-width: 900px) {
    .beats ol { grid-template-columns: 1fr; }
    .product-grid, .flip .product-grid { grid-template-columns: 1fr; }
    .flip .product-copy { order: 0; }
  }
  @media (max-width: 767px), (max-aspect-ratio: 4/5) {
    .display { font-size: 2.5rem; margin-bottom: var(--space-4); }
    .hero-lede { font-size: var(--size-base); }
  }
</style>

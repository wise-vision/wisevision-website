{
  "name": "wisevision-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "prebuild": "npm run tokens && npm run tool-docs",

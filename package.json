    "astro": "^7.3.5",
    "lenis": "^1.3.26",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
